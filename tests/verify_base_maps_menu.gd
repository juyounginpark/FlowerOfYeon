extends "res://tests/verify_fairy_story.gd"
func run() -> void:
	world=load("res://scripts/grid_stage/world.gd").new();root.add_child(world)
	for runtime in range(1,13):
		world.load_stage(runtime);await frames(2)
		check((world.story!=null)==(runtime in [6,7,8,11]),"Stage3, Stage4, Stage5 and Stage8 retain their story puzzles")
		for candidate in world.rune_candidates:check(candidate.enabled==(runtime not in [6,7,8,11]),"lift activation follows stage puzzle")
		for candidate in world.rune_candidates:check(candidate.auto_board==(runtime==11),"only Stage8 boards lifts automatically")
	world.queue_free();await frames()
	var selection=load("res://scenes/grid_stage/menu.tscn").instantiate();root.add_child(selection)
	for dimensions in [Vector2i(1280,720),Vector2i(960,540),Vector2i(1600,900)]:
		root.size=dimensions;await frames(6)
		check(selection.preview.size.is_equal_approx(selection.size),"pond fills the menu without a practice footer")
		await capture("menu_fixed_%dx%d"%[dimensions.x,dimensions.y])
	selection.stage_buttons[0].pressed.emit();await frames(5)
	check(selection.world.stage_number==4,"Stage1 button opens correct map")
	check(selection.world.transition.phase=="book","selection starts book cinematic")
	selection.world.transition.set_process(false)
	var book=selection.world.transition.book
	check(book.selection_entry and book.state=="write","selection immediately opens illustration and starts writing")
	check(book.new_page==book.old_page and book.new_page!=null and book.turn==1,"selected illustration is fully visible without a page turn")
	check(not book.condensing_scene.visible and not book.ink_reveal.visible,"selection skips condensation, droplet and ink spread")
	await capture("menu_selection_immediate_illustration")
	check(not book.request_turn(),"selection cinematic cannot advance stage on click")
	book.tick(3)
	check(book.state=="read","selection text completes in three seconds")
	book.tick(60)
	check(book.state=="read","selection waits for entry click without timeout")
	check(book.request_turn(),"selection click enters chosen illustration")
	book.tick(1.9)
	check(selection.world.stage_number==4 and selection.world.transition.phase=="descend","book enters selected stage")
	check(not selection.world.book_on_entry,"selection flag consumed")
	selection.world.restart()
	check(book.state=="idle" and selection.world.transition.phase=="descend","restart clears selection cinematic")
	selection.show_selection();await frames()
	check(selection.menu.visible,"Back restores selection")
	selection.queue_free();await frames()
	if not failed:print("PASS: %d base maps and menu checks"%checks)
	quit(1 if failed else 0)
