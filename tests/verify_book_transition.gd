extends "res://tests/verify_fairy_story.gd"
func wait_state(book:Node,wanted:String) -> void:
	for tick in range(120):
		if book.state==wanted:return
		await frames(1)
	check(false,"book reached "+wanted)
func run() -> void:
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(CAPTURES))
	root.size=Vector2i(1280,720)
	world=load("res://scripts/grid_stage/world.gd").new();world.stage_number=4;root.add_child(world)
	world.transition.cancel();world.stage_intro.hide()
	await frames(6)
	world.transition.set_process(false)
	var book=world.transition.book
	world.transition.start()
	check(world.transition.phase=="book" and world.player.input_locked,"clear starts book and locks input")
	await wait_state(book,"shrink")
	check(book.old_frame!=null and book.old_page!=null,"current map captured")
	var glyphs:Array=book._text_glyphs(book.old_title)
	check(glyphs[1].position.y>glyphs[0].position.y and glyphs[1].position.x==glyphs[0].position.x,"vertical glyphs flow top to bottom")
	var text_columns:Array=book._text_lines(book.old_title)
	check(text_columns[1].position.x>text_columns[0].position.x,"sentence columns advance left to right")
	for glyph:Dictionary in glyphs:
		check(Rect2(Vector2.ZERO,book._page_rect().size).has_point(glyph.position),"vertical text stays on right page")
	check(glyphs.any(func(glyph):return glyph.char==" "),"text preserves word spacing")
	check(book.divider_region.has_area(),"generated ink divider has visible pixels")
	check(book.condensing_scene.material.get_shader_parameter("ink_mask")!=null,"generated clipping mask connected")
	book.tick(.65);await capture("book_01_map_becomes_page")
	world.paused=true;var time:float=book.clock;book.tick(.5)
	check(book.clock==time,"pause freezes book")
	world.paused=false
	check(not book.request_turn(),"early click cannot skip ink sequence")
	book.tick(.7);check(book.state=="drop","screen becomes droplet")
	book.tick(.4);await capture("book_00_droplet")
	book.tick(.4);check(book.state=="spread","droplet contacts paper")
	book.tick(.8);await capture("book_01_ink_spreading")
	book.tick(1.1)
	check(book.state=="stamp_approach" and not book.stamped,"completed painting starts stamping before loading next stage")
	check(world.stage_number==4 and book.new_page==null and book.turn==0,"stamp belongs to just-cleared stage")
	check(book.old_title.contains(world.stage_data.get("story_title","")),"cleared chapter title is retained")
	check(not book.request_turn(),"click cannot skip stamping")
	book.tick(.35);await capture("book_01_stamp_approach")
	world.paused=true
	time=book.clock;book.tick(1)
	check(book.clock==time and not book.stamped,"pause freezes hand before contact")
	world.paused=false
	book.tick(.35)
	check(book.state=="stamp_press" and book.stamped,"ink appears only at stamp contact")
	check(world.stage_number==4 and book.turn==0,"stamp contacts cleared page before turn")
	await capture("book_01_stamp_contact")
	mouse_button(Vector2(900,500),true);mouse_button(Vector2(900,500),false)
	check(book.state=="stamp_press","click cannot skip stamp contact")
	book.tick(.24);book.tick(.65)
	check(book.state=="stamp_hold" and book.stamped,"impression remains after hand retreats")
	var half_diagonal:float=book._stamp_size()/sqrt(2.0)
	var seal_bounds:=Rect2(book._stamp_center()-Vector2.ONE*half_diagonal,Vector2.ONE*half_diagonal*2)
	check(book._page_rect().encloses(seal_bounds),"rotated seal fits within right page")
	await capture("book_01_stamped_cleared_page")
	world.paused=true;book.tick(2)
	check(book.state=="stamp_hold","pause preserves final impression hold")
	world.paused=false;book.tick(1.1)
	check(book.state=="load_next" and book.stamped,"completed stamp automatically starts next page load")
	check(not book.request_turn(),"click cannot skip automatic page turn")
	await wait_state(book,"turn")
	check(world.stage_number==5 and world.player.input_locked,"next map loads only after stamping")
	check(world.stage_intro.waiting_for_hand and not world.stage_intro.visible,"next title waits behind book")
	var guide=world.stage_root.get_node("ButterflyGuide")
	var guide_time:float=guide.clock;guide._process(.5)
	check(guide.clock==guide_time,"next butterfly waits for page")
	await capture("book_02_open_spread")
	book.tick(.65)
	book.tick(.8);await capture("book_03_turn_front")
	check(book.stamped and book.turn>0 and book.turn<.5,"cleared seal stays on front of turning sheet")
	book.tick(.6);await capture("book_04_turn_back")
	book.tick(.7);check(book.state=="settle","page turn finishes")
	book.tick(.7)
	check(book.state=="write","next chapter writing follows stamped page turn")
	book.tick(.7);await capture("book_05_brush_title")
	book.tick(1.5);await capture("book_06_brush_story")
	world.paused=true;time=book.clock;book.tick(1)
	check(book.clock==time,"writing pauses with book")
	world.paused=false;book.tick(.8)
	check(book.state=="read" and book.new_title!=book.old_title,"next chapter finishes without another stamp")
	await capture("book_06_finished_text")
	check(book.WRITE_SECONDS==3.0,"all text visible within three seconds")
	book.tick(60);check(book.state=="read","next chapter waits for entry click")
	check(book.request_turn(),"click enters next illustration")
	check(not book.request_turn(),"duplicate entry click ignored")
	book.tick(.6);await capture("book_07_enter_next_page")
	book.tick(1.3)
	check(book.state=="idle" and not book.visible,"book releases overlay")
	check(world.transition.phase=="descend" and world.transition.hand.visible,"next entry hand starts")
	for i in range(180):world.transition._process(1.0/60)
	check(not world.transition.active and not world.player.input_locked,"next stage playable")
	check(world.hud.visible and world.stage_intro.visible,"UI restored")
	world.transition.start();await wait_state(book,"shrink")
	book.tick(2);book.tick(1);book.tick(2);book.request_turn();world.restart();await frames(6)
	check(book.state=="idle" and not book.stamped and world.transition.phase=="descend","restart cancels stamping")
	check(world.hud.visible,"restart restores HUD")
	world.transition.cancel()
	world.transition.start_selection_entry();await wait_state(book,"write")
	check(not book.condensing_scene.visible and not book.ink_reveal.visible,"selection immediately shows the illustration")
	book.tick(3)
	check(book.state=="read" and not book.stamped,"map selection does not receive a clear seal")
	book.tick(60);check(book.state=="read","selection keeps click-to-enter behavior")
	check(book.request_turn(),"selection entry click still works")
	world.transition.cancel();check(not book.stamped,"cancel clears impression for next sequence")
	if "--preview-only" in OS.get_cmdline_user_args():
		world.queue_free();await frames(3)
		print("PASS: %d book preview checks"%checks);quit(0);return
	for runtime in [1,2,5,6,7,8,9,10,11]:
		world.load_stage(runtime);world.transition.cancel();await frames(3)
		world.transition.start();await wait_state(book,"shrink");book.tick(2);book.tick(1);book.tick(2);book.request_turn()
		check(world.stage_number==runtime and book.state=="stamp_approach","stamp precedes next stage load from runtime %d"%runtime)
		book.tick(.7);book.tick(.24);book.tick(.65);book.tick(1.1)
		await wait_state(book,"turn")
		check(world.stage_number==runtime+1,"correct destination from runtime %d"%runtime)
		book.tick(3);book.tick(1);book.tick(7);book.request_turn();book.tick(2)
		check(world.transition.phase=="descend","destination enters normally")
	for runtime in [3,12]:
		world.load_stage(runtime);world.transition.cancel();world.transition.start()
		check(world.transition.phase=="beat" and book.state=="idle","final map has no nonexistent next page")
	world.queue_free();await frames(3)
	if not failed:print("PASS: %d book transition checks"%checks)
	quit(1 if failed else 0)
