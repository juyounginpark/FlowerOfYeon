extends "res://tests/verify_fairy_story.gd"
func run() -> void:
	root.size=Vector2i(1280,720)
	world=load("res://scripts/grid_stage/world.gd").new();world.stage_number=11;root.add_child(world)
	world.transition.cancel()
	var intro=world.stage_intro;intro.set_process(false);intro.begin(11,false)
	intro._process(1.3)
	check(intro.brush.visible and intro.brush.modulate.a>.95,"brush sweeps across title")
	check(float(intro.backdrop.get_shader_parameter("sweep"))>0 and float(intro.backdrop.get_shader_parameter("sweep"))<1,"stroke reveal follows brush")
	await capture("title_brush_sweep")
	intro._process(1.2)
	check(not intro.brush.visible and intro.title.modulate.a==1,"brush lifts away and title fully revealed")
	await capture("title_brush_complete")
	intro._process(intro.WRITE_END+intro.HOLD_SECONDS-intro.elapsed-.01)
	check(not intro.fading and intro.panel.modulate.a==1,"full title holds for 2 seconds")
	intro._process(.02)
	check(intro.fading,"fade begins after full hold")
	intro._process(1)
	check(not intro.panel.visible,"title finishes fading")
	intro.begin(11,true);intro._process(4.5)
	check(not intro.fading and intro.elapsed==0 and intro.brush.modulate.a==0,"title and brush wait until player is placed")
	world.paused=true;var elapsed:float=intro.elapsed;intro._process(.5)
	check(intro.elapsed==elapsed,"pause freezes brush and title")
	world.paused=false
	world.transition.start_entry();world.transition.advance("release");world.transition.phase_time=.74
	world.transition._process(.02)
	check(not intro.waiting_for_hand,"real hand release starts title")
	intro._process(.02)
	check(not intro.fading and intro.elapsed>0,"title begins after release instead of fading")
	intro._process(1.3)
	check(intro.brush.visible and intro.brush.modulate.a>.9,"right hand paints after placement")
	world.restart()
	check(not intro.fading and intro.elapsed==0,"restart resets brush sequence")
	world.queue_free();await frames()
	if not failed:print("PASS: %d brush-title checks"%checks)
	quit(1 if failed else 0)
